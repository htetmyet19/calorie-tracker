<?xml version="1.0" encoding="utf-8"?>
<!--
  Local development only: the FastAPI backend runs over plain HTTP on the home LAN
  (e.g. http://192.168.1.100:8000), and the server address is user-configurable, so
  cleartext is allowed app-wide. The Gemini API key never leaves the backend; only
  meal photos and meal logs travel over this connection. If the backend is ever
  exposed beyond the LAN, put it behind HTTPS and remove this permission.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
